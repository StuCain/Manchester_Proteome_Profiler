# Base image with R, Shiny Server, and tidyverse preinstalled
FROM rocker/shiny-verse:4.5.0

# ---- Metadata Labels ----
LABEL org.opencontainers.image.title="Manchester Proteome Profiler"
LABEL org.opencontainers.image.description="R Shiny app for downstream analysis of quantitative proteomics data. Supports MaxQuant, FragPipe, Proteome Discoverer, and Spectronaut. Includes normalization, imputation, clustering, GO enrichment, and protein interaction analysis."
LABEL org.opencontainers.image.version="1.0"
LABEL org.opencontainers.image.url="https://github.com/StuCain/Manchester_Proteome_Profiler"
LABEL org.opencontainers.image.source="https://github.com/StuCain/Manchester_Proteome_Profiler"
LABEL org.opencontainers.image.documentation="https://github.com/StuCain/Manchester_Proteome_Profiler"
LABEL org.opencontainers.image.authors="Stuart Cain"

# ---- System dependencies ----
# Installs key libraries required by R, Bioconductor, and Shiny packages
RUN apt-get update && apt-get install -y \
    sudo \                            # administrative privileges
    pandoc \                          # used by R Markdown and report generation
    libcurl4-gnutls-dev \             # needed for HTTPS and API requests
    libcairo2-dev \                   # required for graphics and plots
    libxt-dev \                       # X11 support for plotting
    libssl-dev \                      # SSL support for secure connections
    libssh2-1-dev\                    # SSH support for package downloads
    libbz2-dev \                      # compression library for data reading
    libhdf5-dev \                     # HDF5 format support
    build-essential \                 # compilers (gcc/g++, make, etc.)
    libgd-dev \                       # graphics device dependency
    libudunits2-dev \                 # units conversion for spatial packages
    libproj-dev \                     # map projections for spatial data
    libgdal-dev \                     # GIS / geospatial data support
    libglpk-dev                       # optimization solver library

# ---- CRAN package installation ----
# Installs core CRAN and Shiny-related packages used throughout the app
RUN Rscript -e 'install.packages(c("devtools", "tidyverse", "ggrepel", "httr", "rjson", "mvtnorm", "tmvtnorm", \
"DT", "BiocManager", "shiny", "shinyalert", "shinydashboard", \
"shinyjs", "svglite", "shinyBS", "shinyWidgets", "shinycssloaders", \
"shiny.info", "circlize", "data.table", "scales", "gridtext", "waiter", "shinythemes", "RColorBrewer", "readxl", \
"rmarkdown", "tinytex", "assertthat", "shinyWidgets", "fdrtool"), dependencies=TRUE)'

# ---- DEP requirement ----
# Needed for the Bioconductor package DEP (depends on NetCDF libraries)
RUN apt-get install libnetcdf-dev

# ---- Bioconductor package installation ----
# Adds proteomics and visualization libraries used for MPP
RUN Rscript -e "BiocManager::install('DEP', ask=F, dependencies=TRUE)"                 # Differential enrichment analysis
RUN Rscript -e "BiocManager::install('ComplexHeatmap', ask=F, dependencies=TRUE)"     # Heatmap visualization
RUN Rscript -e "BiocManager::install(pkgs=c('EnhancedVolcano', 'org.Hs.eg.db', 'org.Mm.eg.db', 'HDO.db', 'VennDetail'), ask=F, dependencies=TRUE)" # Gene annotations and plots
RUN Rscript -e "BiocManager::install('clusterProfiler', ask=F, dependencies=TRUE)"    # GO/KEGG enrichment analysis

# ---- QFeatures & preprocessCore ----
# Multi-threading disabled to prevent Docker segmentation faults
RUN Rscript -e "BiocManager::install('QFeatures', configure.args='--disable-threading')"
RUN Rscript -e "BiocManager::install('preprocessCore', configure.args='--disable-threading', force= TRUE, update=TRUE, type = 'source')"

# ---- Species annotation databases ----
RUN Rscript -e "BiocManager::install('org.At.tair.db', ask=F, dependencies=TRUE)"     # Arabidopsis
RUN Rscript -e "BiocManager::install('org.Xl.eg.db', ask=F, dependencies=TRUE)"       # Xenopus

# ---- Async + Visualization packages ----
RUN Rscript -e 'install.packages(c("promises", "future", "ggtangle"), dependencies=TRUE)'  # async Shiny + Cnet plots
RUN Rscript -e 'install.packages(c("tidygraph", "ggraph"), dependencies=TRUE)'        # Network visualization


# ---- GitHub installs ----
RUN Rscript -e 'devtools::install_github("npjc/biogridr")'     # BioGRID protein interaction support
RUN Rscript -e "BiocManager::install('STRINGdb', ask=F, dependencies=TRUE)"           # STRING protein network database
RUN Rscript -e 'devtools::install_github("guokai8/VennDetail")'                       # Venn diagram enhancements

# ---- TinyTeX installation ----
# Used for PDF report rendering via R Markdown
#RUN apt-get install perl wget -y  
#RUN wget -qO- "https://yihui.org/tinytex/install-bin-unix.sh" | sh 
RUN Rscript -e "install.packages('tinytex', repos='https://cloud.r-project.org'); tinytex::install_tinytex((force = TRUE))"

# Add TinyTeX to PATH and update it
ENV PATH="/root/.TinyTeX/bin/x86_64-linux:$PATH"
RUN tlmgr update --self
RUN Rscript -e "tinytex::is_tinytex()"

# Install extra LaTeX packages and make available to shiny user
ENV PATH="$PATH:/root/.TinyTeX/bin/x86_64-linux"
RUN tlmgr install sourcesanspro
RUN tlmgr install ly1
RUN tlmgr install bookmark
RUN cp -r /root/.TinyTeX /home/shiny

# ---- Clean up default index and copy app ----
RUN sudo rm /srv/shiny-server/index.html

# Expose Shiny app on port 3838
EXPOSE 3838

# Copy app code and custom Shiny server configuration
COPY ./ /srv/shiny-server/shiny-mpp
COPY shiny-server.conf /etc/shiny-server/shiny-server.conf

# Set permissions for the Shiny app
RUN chmod -R +r /srv/shiny-server/shiny-mpp
RUN chown -R shiny:shiny /srv/shiny-server
