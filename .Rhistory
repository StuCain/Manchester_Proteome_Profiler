}
DF <- data.frame(do.call(rbind, strsplit(myvalues, ":", fixed=TRUE)))
DF <- tibble::rownames_to_column(DF, "variable")
DF<-data.frame(DF[-1])
colnames(DF) <- colnames(all_settings)
total_settings<-rbind(all_settings,DF)
total_settings
})
